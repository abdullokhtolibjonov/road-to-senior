{
  "name": "road-to-senior",
  "version": "1.0.0",
  "description": "A personal test-automation portfolio project built to master **TypeScript** through practical, progressively harder test-engineering work: **E2E tests** (Playwright), **API tests** (Playwright request context), and **performance tests** (k6).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p performance/k6",
    "test:e2e": "npx playwright test --project=chromium --project=firefox",
    "test:api": "npx playwright test --project=api",
    "test:e2e:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test --grep @smoke --project=chromium",
    "test:regression": "npx playwright test --grep-invert @network",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "perf:smoke": "k6 run performance/k6/scenarios/smoke.ts",
    "perf:load": "k6 run performance/k6/scenarios/load.ts",
    "perf:stress": "k6 run -e BASE_URL=http://localhost:3333 performance/k6/scenarios/stress.ts",
    "perf:spike": "k6 run -e BASE_URL=http://localhost:3333 performance/k6/scenarios/spike.ts",
    "perf:results-dir": "node -e \"require('fs').mkdirSync('performance/k6/results', { recursive: true })\"",
    "perf:load:report": "npm run perf:results-dir && k6 run --summary-export=performance/k6/results/load-summary.json --out web-dashboard=export=performance/k6/results/load-report.html performance/k6/scenarios/load.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullokhtolibjonov/road-to-senior.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/abdullokhtolibjonov/road-to-senior/issues"
  },
  "homepage": "https://github.com/abdullokhtolibjonov/road-to-senior#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/k6": "^2.3.0",
    "@types/node": "^26.6.2",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "6.0",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
